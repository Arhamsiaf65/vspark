# Names only. Copy to .env.local and fill in values. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (no NEXT_PUBLIC_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=   # Gmail: an App Password, not your login password
EMAIL_FROM="Captionly <you@gmail.com>"
CRON_SECRET=

# Tests only (npm run test:integration)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
